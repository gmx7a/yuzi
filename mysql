CREATE DATABASE MOVIETICKETDB;

USE MOVIETICKETDB;

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50),
    password VARCHAR(50)
);

CREATE TABLE booking (
    id INT AUTO_INCREMENT PRIMARY KEY,
    movie VARCHAR(100),
    date DATE,
    hall VARCHAR(20),
    seat VARCHAR(10)
);

